<UserControl x:Class="ProseFlow.UI.Views.Onboarding.HotkeyTutorialView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProseFlow.UI.ViewModels.Onboarding"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:HotkeyTutorialViewModel">

    <StackPanel Spacing="16" TextBlock.TextAlignment="Center">
        <TextBlock Classes="h3" Text="{Binding HeaderText}" TextWrapping="Wrap" />
        <TextBlock Classes="Small" Text="{Binding InstructionText}" TextWrapping="Wrap" />

        <Border Classes="Keybind" Padding="12, 8" CornerRadius="{DynamicResource MdCornerRadius}">
            <TextBlock Classes="h4" Text="{Binding ConfiguredHotkey}" />
        </Border>

        <TextBox Text="{Binding SampleText}" TextAlignment="Center" MinHeight="100" TextWrapping="Wrap"
                 Margin="24, 0" />

        <!-- Simulated Diff View -->
        <Border IsVisible="{Binding ShowSimulatedDiffView}"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource LgCornerRadius}"
                Padding="16"
                HorizontalAlignment="Center"
                MinWidth="500">
            <StackPanel Spacing="12">
                <TextBlock Classes="h4" Text="Review Changes" TextAlignment="Left"/>
                <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="12">
                    <!-- Original -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="Small Muted" Text="Original" />
                        <Border Padding="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="{DynamicResource MdCornerRadius}">
                            <TextBlock TextWrapping="Wrap">
                                ProseFlow is a <Run Foreground="Red" Classes="Destructive">grate</Run> tool it <Run Foreground="Red" Classes="Destructive">hlps</Run> me <Run Foreground="Red" Classes="Destructive">writng</Run> better
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    
                    <Separator Grid.Column="1" Width="1" Height="50" />

                    <!-- Suggested -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="Small Muted" Text="Suggested" />
                        <Border Padding="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="{DynamicResource MdCornerRadius}">
                            <TextBlock TextWrapping="Wrap">
                                ProseFlow is a <Run Classes="Success">great</Run> tool. It <Run Classes="Success">helps</Run> me <Run Classes="Success">write</Run> better.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
                <Button Classes="Primary" HorizontalAlignment="Right"
                        Command="{Binding SimulateAcceptDiffCommand}"
                        Content="Accept" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>